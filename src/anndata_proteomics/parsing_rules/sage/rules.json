{
  "schema_version": "0.2",
  "file_version": "2",
  "software_name": "Sage",
  "software_version": "^0\\.",
  "base": {
    "input_shape": "wide",
    "axis": {
      "obs_keys": [
        "sample"
      ],
      "duplicates": {
        "mode": "error"
      }
    },
    "columns": {
      "obs": {
        "select": {
          "sample": "<sample>"
        }
      },
      "var": {
        "select": {
          "Peptide": "peptide",
          "Proteins": "proteins",
          "Q_Value": "q_value",
          "Score": "score",
          "Spectral_Angle": "spectral_angle"
        },
        "types": {
          "Q_Value": "number",
          "Score": "number",
          "Spectral_Angle": "number"
        },
        "compute": [
          {
            "name": "ProForma_peptidoform",
            "from": [
              "Peptide"
            ],
            "how": "proforma_sequence"
          },
          {
            "name": "ProForma_peptide",
            "from": [
              "Peptide"
            ],
            "how": "stripped_sequence"
          }
        ]
      }
    },
    "column_roles": {
      "protein_assignment": "Proteins",
      "fasta_accessions": "Proteins"
    },
    "layers": [
      {
        "name": "Intensity",
        "source": "^(?P<sample>.+)\\.(?:mzML|mzml|mzML\\.gz|mzml\\.gz|mgf|raw|d)$",
        "missing_values": [
          0
        ]
      }
    ],
    "modifications": {
      "source_column": "peptide",
      "parser": "token_regex",
      "token_pattern": "\\[([^\\]]+)\\]",
      "token_position": "after_residue",
      "case_sensitive": false,
      "unknown_policy": "preserve",
      "output_column": "proforma_sequence",
      "map": [
        {
          "token": "+57.021465",
          "accession": "UNIMOD:4"
        },
        {
          "token": "+15.994915",
          "accession": "UNIMOD:35"
        },
        {
          "token": "+42.010567",
          "accession": "UNIMOD:1"
        }
      ]
    }
  },
  "levels": {
    "ion": {
      "requires_search_parameters": {
        "combine_charge_states": false
      },
      "axis": {
        "var_keys": [
          "ProForma_ion"
        ],
        "x_layer": "Intensity"
      },
      "columns": {
        "var": {
          "select": {
            "Charge": "charge"
          },
          "types": {
            "Charge": "integer"
          },
          "compute": [
            {
              "name": "ProForma_ion",
              "from": [
                "ProForma_peptidoform",
                "Charge"
              ],
              "how": "proforma_ion"
            }
          ]
        }
      }
    },
    "peptidoform": {
      "requires_search_parameters": {
        "combine_charge_states": true
      },
      "axis": {
        "var_keys": [
          "ProForma_peptidoform"
        ],
        "x_layer": "Intensity"
      }
    }
  }
}
