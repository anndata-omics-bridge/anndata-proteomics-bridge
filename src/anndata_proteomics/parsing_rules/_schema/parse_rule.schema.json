{
  "$defs": {
    "Axis": {
      "additionalProperties": false,
      "properties": {
        "obs_keys": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Obs Keys",
          "type": "array"
        },
        "var_keys": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Var Keys",
          "type": "array"
        },
        "x_layer": {
          "title": "X Layer",
          "type": "string"
        },
        "duplicates": {
          "$ref": "#/$defs/Duplicates"
        }
      },
      "required": [
        "obs_keys",
        "var_keys",
        "x_layer"
      ],
      "title": "Axis",
      "type": "object"
    },
    "ColumnCompute": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "from": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "From",
          "type": "array"
        },
        "how": {
          "enum": [
            "coalesce",
            "join_nonempty",
            "proforma_sequence",
            "stripped_sequence",
            "proforma_ion",
            "proforma_fragment"
          ],
          "title": "How",
          "type": "string"
        },
        "separator": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Separator"
        }
      },
      "required": [
        "name",
        "from",
        "how"
      ],
      "title": "ColumnCompute",
      "type": "object"
    },
    "ColumnGroup": {
      "additionalProperties": false,
      "description": "Declared axis columns: required ``select``, best-effort ``optional_select``, ``compute``.\n\n``select`` sources must be present in the input \u2014 they gate rule recognition. Columns a\nvendor emits only for some configurations belong in ``optional_select``: captured when the\nsource is present, silently skipped when absent, and never part of recognition. This\nmirrors ``Layer.required = false`` so one vendor document can declare the full superset of\nan export's volatile columns without rejecting the exports that omit some.",
      "properties": {
        "select": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Select",
          "type": "object"
        },
        "optional_select": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Optional Select",
          "type": "object"
        },
        "types": {
          "additionalProperties": {
            "enum": [
              "string",
              "integer",
              "number",
              "boolean"
            ],
            "type": "string"
          },
          "title": "Types",
          "type": "object"
        },
        "compute": {
          "items": {
            "$ref": "#/$defs/ColumnCompute"
          },
          "title": "Compute",
          "type": "array"
        }
      },
      "title": "ColumnGroup",
      "type": "object"
    },
    "ColumnLabeledFragments": {
      "additionalProperties": false,
      "description": "DIA-NN exports carrying fragment identities in a packed ``label_column``.\n\n``label_column`` (e.g. ``Fragment.Info``, tokens like ``b4-unknown^1/327.16``)\nyields ``label_output`` = the token before ``/``.",
      "properties": {
        "label_strategy": {
          "const": "column",
          "title": "Label Strategy",
          "type": "string"
        },
        "value_columns": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Value Columns",
          "type": "array"
        },
        "label_column": {
          "title": "Label Column",
          "type": "string"
        },
        "delimiter": {
          "default": ";",
          "title": "Delimiter",
          "type": "string"
        },
        "label_output": {
          "default": "fragment_label",
          "title": "Label Output",
          "type": "string"
        }
      },
      "required": [
        "label_strategy",
        "value_columns",
        "label_column"
      ],
      "title": "ColumnLabeledFragments",
      "type": "object"
    },
    "ColumnRoles": {
      "additionalProperties": false,
      "description": "Semantic locations needed by downstream canonical-data consumers.",
      "properties": {
        "protein_assignment": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Protein Assignment"
        },
        "fasta_accessions": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fasta Accessions"
        }
      },
      "title": "ColumnRoles",
      "type": "object"
    },
    "Columns": {
      "additionalProperties": false,
      "properties": {
        "obs": {
          "$ref": "#/$defs/ColumnGroup"
        },
        "var": {
          "$ref": "#/$defs/ColumnGroup"
        }
      },
      "required": [
        "obs",
        "var"
      ],
      "title": "Columns",
      "type": "object"
    },
    "Duplicates": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "default": "error",
          "enum": [
            "error",
            "aggregate",
            "keep_first",
            "keep_all_as_raw_table"
          ],
          "title": "Mode",
          "type": "string"
        }
      },
      "title": "Duplicates",
      "type": "object"
    },
    "Layer": {
      "additionalProperties": false,
      "description": "A quantitative layer fed by one ``source``.\n\n``source`` interpretation is owned by the rule-level ``input_shape``:\n\n- ``input_shape=\"long\"``: ``source`` is an exact vendor column name.\n- ``input_shape=\"wide\"``: ``source`` is a regex over matrix headers and must\n  contain a ``(?P<sample>...)`` named group (enforced on ``ParseRule``).\n\nLayers are optional by default: captured when the ``source`` is present in the\ninput and silently skipped when absent, so a rule can declare the full superset\nof a vendor's volatile columns without rejecting exports that omit some. Set\n``required = true`` to gate a layer (a file missing it is rejected). The\n``axis.x_layer`` is always required regardless of this flag.\n\nA regex ``value_pattern`` handles vendor columns whose cells are structured strings\nrather than bare numbers (PEAKS ``AScore`` is ``site:modification:score``). Its\n``pattern`` has exactly one capture group, applied per cell before numeric coercion;\nthe first match wins and non-matching cells become NaN. ``mode = \"none\"`` explicitly\ndeclares directly parseable scalar values.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "encoding_mode": {
          "default": "numeric",
          "enum": [
            "numeric",
            "factor"
          ],
          "title": "Encoding Mode",
          "type": "string"
        },
        "categories": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Categories",
          "type": "object"
        },
        "missing_values": {
          "items": {
            "type": "number"
          },
          "title": "Missing Values",
          "type": "array"
        },
        "value_pattern": {
          "$ref": "#/$defs/ValuePattern",
          "default": {
            "mode": "none"
          }
        },
        "required": {
          "default": false,
          "title": "Required",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "source"
      ],
      "title": "Layer",
      "type": "object"
    },
    "ModificationMapEntry": {
      "additionalProperties": false,
      "description": "User-facing JSON entry: a vendor token plus the Unimod accession.\n\n``name``, ``target``, ``position`` and ``mass_delta`` are NOT carried\non the entry itself \u2014 they are filled at rule-load time from\n``modifications/unimod_registry.toml``. This keeps the per-tool rule files\nfree of duplicated canonical data and guarantees that all tools agree\non what e.g. ``UNIMOD:35`` means.",
      "properties": {
        "token": {
          "title": "Token",
          "type": "string"
        },
        "accession": {
          "title": "Accession",
          "type": "string"
        }
      },
      "required": [
        "token",
        "accession"
      ],
      "title": "ModificationMapEntry",
      "type": "object"
    },
    "NoValuePattern": {
      "additionalProperties": false,
      "description": "A numeric layer contains directly parseable scalar values.",
      "properties": {
        "mode": {
          "const": "none",
          "default": "none",
          "title": "Mode",
          "type": "string"
        }
      },
      "title": "NoValuePattern",
      "type": "object"
    },
    "PositionalFragments": {
      "additionalProperties": false,
      "description": "Older DIA-NN exports with no per-fragment label column.\n\nFragment labels are synthesised positionally (``frag_0``, ``frag_1``, \u2026) by\nindex within the precursor.",
      "properties": {
        "label_strategy": {
          "const": "positional",
          "title": "Label Strategy",
          "type": "string"
        },
        "value_columns": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Value Columns",
          "type": "array"
        },
        "delimiter": {
          "default": ";",
          "title": "Delimiter",
          "type": "string"
        },
        "label_output": {
          "default": "fragment_label",
          "title": "Label Output",
          "type": "string"
        }
      },
      "required": [
        "label_strategy",
        "value_columns"
      ],
      "title": "PositionalFragments",
      "type": "object"
    },
    "RegexValuePattern": {
      "additionalProperties": false,
      "description": "Extract one numeric capture group from each structured layer value.",
      "properties": {
        "mode": {
          "const": "regex",
          "default": "regex",
          "title": "Mode",
          "type": "string"
        },
        "pattern": {
          "minLength": 1,
          "title": "Pattern",
          "type": "string"
        }
      },
      "required": [
        "pattern"
      ],
      "title": "RegexValuePattern",
      "type": "object"
    },
    "SampleNameCleanup": {
      "additionalProperties": false,
      "properties": {
        "pattern": {
          "minLength": 1,
          "title": "Pattern",
          "type": "string"
        }
      },
      "required": [
        "pattern"
      ],
      "title": "SampleNameCleanup",
      "type": "object"
    },
    "SiteListModifications": {
      "additionalProperties": false,
      "description": "Read modifications from parallel name and site columns beside a bare sequence.\n\nThe alphabase layout, used by AlphaDIA::\n\n    sequence     mods                            mod_sites\n    TCSSFIAAMER  Oxidation@M;Carbamidomethyl@C   9;2\n\n``mods`` and ``mod_sites`` are ``delimiter``-joined and paired **index-wise**,\nnot sorted \u2014 above, ``Oxidation@M`` sits at 9 and ``Carbamidomethyl@C`` at 2.\nSites are ``site_base``-indexed into the sequence; site ``0`` denotes the\nN-terminus regardless of ``site_base`` (AlphaDIA writes ``Acetyl@Protein_N-term``\nthat way). Tokens are matched exactly against ``map``, since a name like\n``Oxidation@M`` already carries its own target.",
      "properties": {
        "parser": {
          "const": "site_list",
          "title": "Parser",
          "type": "string"
        },
        "sequence_column": {
          "title": "Sequence Column",
          "type": "string"
        },
        "modification_column": {
          "title": "Modification Column",
          "type": "string"
        },
        "site_column": {
          "title": "Site Column",
          "type": "string"
        },
        "delimiter": {
          "default": ";",
          "title": "Delimiter",
          "type": "string"
        },
        "site_base": {
          "default": 1,
          "maximum": 1,
          "minimum": 0,
          "title": "Site Base",
          "type": "integer"
        },
        "case_sensitive": {
          "default": false,
          "title": "Case Sensitive",
          "type": "boolean"
        },
        "unknown_policy": {
          "default": "preserve",
          "enum": [
            "preserve",
            "drop",
            "error"
          ],
          "title": "Unknown Policy",
          "type": "string"
        },
        "output_column": {
          "default": "proforma_sequence",
          "title": "Output Column",
          "type": "string"
        },
        "map": {
          "items": {
            "$ref": "#/$defs/ModificationMapEntry"
          },
          "minItems": 1,
          "title": "Map",
          "type": "array"
        }
      },
      "required": [
        "parser",
        "sequence_column",
        "modification_column",
        "site_column",
        "map"
      ],
      "title": "SiteListModifications",
      "type": "object"
    },
    "TokenRegexModifications": {
      "additionalProperties": false,
      "description": "Extract vendor modification tokens with a regex and map them to Unimod.\n\nFor vendors that write modifications inline in the sequence itself, e.g.\n``\"PEPM[15.9949]TIDE\"`` or ``\"_(ac)PEPTIDEM(ox)_\"``.",
      "properties": {
        "parser": {
          "const": "token_regex",
          "title": "Parser",
          "type": "string"
        },
        "source_column": {
          "title": "Source Column",
          "type": "string"
        },
        "token_pattern": {
          "title": "Token Pattern",
          "type": "string"
        },
        "token_position": {
          "default": "after_residue",
          "enum": [
            "before_residue",
            "after_residue",
            "n_term",
            "c_term",
            "embedded",
            "unknown"
          ],
          "title": "Token Position",
          "type": "string"
        },
        "case_sensitive": {
          "default": false,
          "title": "Case Sensitive",
          "type": "boolean"
        },
        "unknown_policy": {
          "default": "preserve",
          "enum": [
            "preserve",
            "drop",
            "error"
          ],
          "title": "Unknown Policy",
          "type": "string"
        },
        "output_column": {
          "default": "proforma_sequence",
          "title": "Output Column",
          "type": "string"
        },
        "map": {
          "items": {
            "$ref": "#/$defs/ModificationMapEntry"
          },
          "minItems": 1,
          "title": "Map",
          "type": "array"
        }
      },
      "required": [
        "parser",
        "source_column",
        "token_pattern",
        "map"
      ],
      "title": "TokenRegexModifications",
      "type": "object"
    },
    "ValuePattern": {
      "discriminator": {
        "mapping": {
          "none": "#/$defs/NoValuePattern",
          "regex": "#/$defs/RegexValuePattern"
        },
        "propertyName": "mode"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/NoValuePattern"
        },
        {
          "$ref": "#/$defs/RegexValuePattern"
        }
      ]
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "title": "Schema Version",
      "type": "string"
    },
    "file_version": {
      "title": "File Version",
      "type": "string"
    },
    "software_name": {
      "title": "Software Name",
      "type": "string"
    },
    "software_version": {
      "title": "Software Version",
      "type": "string"
    },
    "input_shape": {
      "enum": [
        "long",
        "wide"
      ],
      "title": "Input Shape",
      "type": "string"
    },
    "quantification_level": {
      "enum": [
        "ion",
        "peptidoform",
        "peptide",
        "protein",
        "fragment"
      ],
      "title": "Quantification Level",
      "type": "string"
    },
    "axis": {
      "$ref": "#/$defs/Axis"
    },
    "columns": {
      "$ref": "#/$defs/Columns"
    },
    "column_roles": {
      "$ref": "#/$defs/ColumnRoles"
    },
    "layers": {
      "items": {
        "$ref": "#/$defs/Layer"
      },
      "minItems": 1,
      "title": "Layers",
      "type": "array"
    },
    "sample_name_cleanup": {
      "anyOf": [
        {
          "$ref": "#/$defs/SampleNameCleanup"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "modifications": {
      "anyOf": [
        {
          "discriminator": {
            "mapping": {
              "site_list": "#/$defs/SiteListModifications",
              "token_regex": "#/$defs/TokenRegexModifications"
            },
            "propertyName": "parser"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/TokenRegexModifications"
            },
            {
              "$ref": "#/$defs/SiteListModifications"
            }
          ]
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Modifications"
    },
    "fragments": {
      "anyOf": [
        {
          "discriminator": {
            "mapping": {
              "column": "#/$defs/ColumnLabeledFragments",
              "positional": "#/$defs/PositionalFragments"
            },
            "propertyName": "label_strategy"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/PositionalFragments"
            },
            {
              "$ref": "#/$defs/ColumnLabeledFragments"
            }
          ]
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Fragments"
    }
  },
  "required": [
    "schema_version",
    "file_version",
    "software_name",
    "software_version",
    "input_shape",
    "quantification_level",
    "axis",
    "columns",
    "layers"
  ],
  "title": "ParseRule",
  "type": "object"
}
