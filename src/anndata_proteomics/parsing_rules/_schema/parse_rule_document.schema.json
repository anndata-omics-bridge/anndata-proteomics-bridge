{
  "$defs": {
    "ColumnCompute": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "from": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "From",
          "type": "array"
        },
        "how": {
          "enum": [
            "proforma_sequence",
            "stripped_sequence",
            "proforma_ion",
            "proforma_fragment"
          ],
          "title": "How",
          "type": "string"
        }
      },
      "required": [
        "name",
        "from",
        "how"
      ],
      "title": "ColumnCompute",
      "type": "object"
    },
    "ColumnLabeledFragments": {
      "additionalProperties": false,
      "description": "DIA-NN exports carrying fragment identities in a packed ``label_column``.\n\n``label_column`` (e.g. ``Fragment.Info``, tokens like ``b4-unknown^1/327.16``)\nyields ``label_output`` = the token before ``/``.",
      "properties": {
        "label_strategy": {
          "const": "column",
          "title": "Label Strategy",
          "type": "string"
        },
        "value_columns": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Value Columns",
          "type": "array"
        },
        "label_column": {
          "title": "Label Column",
          "type": "string"
        },
        "delimiter": {
          "default": ";",
          "title": "Delimiter",
          "type": "string"
        },
        "label_output": {
          "default": "fragment_label",
          "title": "Label Output",
          "type": "string"
        }
      },
      "required": [
        "label_strategy",
        "value_columns",
        "label_column"
      ],
      "title": "ColumnLabeledFragments",
      "type": "object"
    },
    "Duplicates": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "default": "error",
          "enum": [
            "error",
            "aggregate",
            "keep_first",
            "keep_all_as_raw_table"
          ],
          "title": "Mode",
          "type": "string"
        }
      },
      "title": "Duplicates",
      "type": "object"
    },
    "Layer": {
      "additionalProperties": false,
      "description": "A quantitative layer fed by one ``source``.\n\n``source`` interpretation is owned by the rule-level ``input_shape``:\n\n- ``input_shape=\"long\"``: ``source`` is an exact vendor column name.\n- ``input_shape=\"wide\"``: ``source`` is a regex over matrix headers and must\n  contain a ``(?P<sample>...)`` named group (enforced on ``ParseRule``).\n\nLayers are optional by default: captured when the ``source`` is present in the\ninput and silently skipped when absent, so a rule can declare the full superset\nof a vendor's volatile columns without rejecting exports that omit some. Set\n``required = true`` to gate a layer (a file missing it is rejected). The\n``axis.x_layer`` is always required regardless of this flag.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "encoding_mode": {
          "default": "numeric",
          "enum": [
            "numeric",
            "factor"
          ],
          "title": "Encoding Mode",
          "type": "string"
        },
        "categories": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Categories",
          "type": "object"
        },
        "required": {
          "default": false,
          "title": "Required",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "source"
      ],
      "title": "Layer",
      "type": "object"
    },
    "ModificationMapEntry": {
      "additionalProperties": false,
      "description": "User-facing JSON entry: a vendor token plus the Unimod accession.\n\n``name``, ``target``, ``position`` and ``mass_delta`` are NOT carried\non the entry itself \u2014 they are filled at rule-load time from\n``modifications/unimod_registry.toml``. This keeps the per-tool rule files\nfree of duplicated canonical data and guarantees that all tools agree\non what e.g. ``UNIMOD:35`` means.",
      "properties": {
        "token": {
          "title": "Token",
          "type": "string"
        },
        "accession": {
          "title": "Accession",
          "type": "string"
        }
      },
      "required": [
        "token",
        "accession"
      ],
      "title": "ModificationMapEntry",
      "type": "object"
    },
    "PartialAxis": {
      "additionalProperties": false,
      "description": "Axis fragment that becomes complete after merging a document level with its base.",
      "properties": {
        "obs_keys": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Obs Keys"
        },
        "var_keys": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Var Keys"
        },
        "x_layer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "X Layer"
        },
        "duplicates": {
          "anyOf": [
            {
              "$ref": "#/$defs/Duplicates"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "PartialAxis",
      "type": "object"
    },
    "PartialColumnGroup": {
      "additionalProperties": false,
      "description": "Column-group fragment with presence preserved for deterministic merging.",
      "properties": {
        "select": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Select"
        },
        "compute": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/ColumnCompute"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Compute"
        }
      },
      "title": "PartialColumnGroup",
      "type": "object"
    },
    "PartialColumns": {
      "additionalProperties": false,
      "description": "Partial obs/var column declarations used inside a source document.",
      "properties": {
        "obs": {
          "anyOf": [
            {
              "$ref": "#/$defs/PartialColumnGroup"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "var": {
          "anyOf": [
            {
              "$ref": "#/$defs/PartialColumnGroup"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "PartialColumns",
      "type": "object"
    },
    "PositionalFragments": {
      "additionalProperties": false,
      "description": "Older DIA-NN exports with no per-fragment label column.\n\nFragment labels are synthesised positionally (``frag_0``, ``frag_1``, \u2026) by\nindex within the precursor.",
      "properties": {
        "label_strategy": {
          "const": "positional",
          "title": "Label Strategy",
          "type": "string"
        },
        "value_columns": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Value Columns",
          "type": "array"
        },
        "delimiter": {
          "default": ";",
          "title": "Delimiter",
          "type": "string"
        },
        "label_output": {
          "default": "fragment_label",
          "title": "Label Output",
          "type": "string"
        }
      },
      "required": [
        "label_strategy",
        "value_columns"
      ],
      "title": "PositionalFragments",
      "type": "object"
    },
    "RuleFragment": {
      "additionalProperties": false,
      "description": "Strict partial ParseRule body used by a document base or one level.",
      "properties": {
        "input_shape": {
          "anyOf": [
            {
              "enum": [
                "long",
                "wide"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Shape"
        },
        "axis": {
          "anyOf": [
            {
              "$ref": "#/$defs/PartialAxis"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "columns": {
          "anyOf": [
            {
              "$ref": "#/$defs/PartialColumns"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "layers": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Layer"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Layers"
        },
        "sample_name_cleanup": {
          "anyOf": [
            {
              "$ref": "#/$defs/SampleNameCleanup"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "modifications": {
          "anyOf": [
            {
              "$ref": "#/$defs/TokenRegexModifications"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "fragments": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "column": "#/$defs/ColumnLabeledFragments",
                  "positional": "#/$defs/PositionalFragments"
                },
                "propertyName": "label_strategy"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/PositionalFragments"
                },
                {
                  "$ref": "#/$defs/ColumnLabeledFragments"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fragments"
        }
      },
      "title": "RuleFragment",
      "type": "object"
    },
    "SampleNameCleanup": {
      "additionalProperties": false,
      "properties": {
        "pattern": {
          "default": "",
          "title": "Pattern",
          "type": "string"
        }
      },
      "title": "SampleNameCleanup",
      "type": "object"
    },
    "TokenRegexModifications": {
      "additionalProperties": false,
      "description": "Extract vendor modification tokens with a regex and map them to Unimod.\n\n``token_regex`` is the only modification parser with a runtime\nimplementation (see ``modifications.pipeline``), so it is the only\naccepted ``parser`` value.",
      "properties": {
        "parser": {
          "const": "token_regex",
          "title": "Parser",
          "type": "string"
        },
        "source_column": {
          "title": "Source Column",
          "type": "string"
        },
        "token_pattern": {
          "title": "Token Pattern",
          "type": "string"
        },
        "token_position": {
          "default": "after_residue",
          "enum": [
            "before_residue",
            "after_residue",
            "n_term",
            "c_term",
            "embedded",
            "unknown"
          ],
          "title": "Token Position",
          "type": "string"
        },
        "case_sensitive": {
          "default": false,
          "title": "Case Sensitive",
          "type": "boolean"
        },
        "unknown_policy": {
          "default": "preserve",
          "enum": [
            "preserve",
            "drop",
            "error"
          ],
          "title": "Unknown Policy",
          "type": "string"
        },
        "output_column": {
          "default": "proforma_sequence",
          "title": "Output Column",
          "type": "string"
        },
        "map": {
          "items": {
            "$ref": "#/$defs/ModificationMapEntry"
          },
          "minItems": 1,
          "title": "Map",
          "type": "array"
        }
      },
      "required": [
        "parser",
        "source_column",
        "token_pattern",
        "map"
      ],
      "title": "TokenRegexModifications",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One self-contained software-version document with shared and level rules.",
  "properties": {
    "schema_version": {
      "title": "Schema Version",
      "type": "string"
    },
    "file_version": {
      "title": "File Version",
      "type": "string"
    },
    "software_name": {
      "title": "Software Name",
      "type": "string"
    },
    "software_version": {
      "title": "Software Version",
      "type": "string"
    },
    "base": {
      "$ref": "#/$defs/RuleFragment"
    },
    "levels": {
      "additionalProperties": {
        "$ref": "#/$defs/RuleFragment"
      },
      "minProperties": 1,
      "propertyNames": {
        "enum": [
          "ion",
          "peptidoform",
          "peptide",
          "protein",
          "fragment"
        ]
      },
      "title": "Levels",
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "file_version",
    "software_name",
    "software_version",
    "base",
    "levels"
  ],
  "title": "ParseRuleDocument",
  "type": "object"
}
