{
  "$defs": {
    "ColumnCompute": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "from": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "From",
          "type": "array"
        },
        "how": {
          "enum": [
            "coalesce",
            "join_nonempty",
            "proforma_sequence",
            "stripped_sequence",
            "proforma_ion",
            "proforma_fragment"
          ],
          "title": "How",
          "type": "string"
        },
        "separator": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Separator"
        }
      },
      "required": [
        "name",
        "from",
        "how"
      ],
      "title": "ColumnCompute",
      "type": "object"
    },
    "ColumnLabeledFragments": {
      "additionalProperties": false,
      "description": "DIA-NN exports carrying fragment identities in a packed ``label_column``.\n\n``label_column`` (e.g. ``Fragment.Info``, tokens like ``b4-unknown^1/327.16``)\nyields ``label_output`` = the token before ``/``.",
      "properties": {
        "label_strategy": {
          "const": "column",
          "title": "Label Strategy",
          "type": "string"
        },
        "value_columns": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Value Columns",
          "type": "array"
        },
        "label_column": {
          "title": "Label Column",
          "type": "string"
        },
        "delimiter": {
          "default": ";",
          "title": "Delimiter",
          "type": "string"
        },
        "label_output": {
          "default": "fragment_label",
          "title": "Label Output",
          "type": "string"
        }
      },
      "required": [
        "label_strategy",
        "value_columns",
        "label_column"
      ],
      "title": "ColumnLabeledFragments",
      "type": "object"
    },
    "ColumnRoles": {
      "additionalProperties": false,
      "description": "Semantic locations needed by downstream canonical-data consumers.",
      "properties": {
        "protein_assignment": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Protein Assignment"
        },
        "fasta_accessions": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fasta Accessions"
        }
      },
      "title": "ColumnRoles",
      "type": "object"
    },
    "Duplicates": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "default": "error",
          "enum": [
            "error",
            "aggregate",
            "keep_first",
            "keep_all_as_raw_table"
          ],
          "title": "Mode",
          "type": "string"
        }
      },
      "title": "Duplicates",
      "type": "object"
    },
    "Layer": {
      "additionalProperties": false,
      "description": "A quantitative layer fed by one ``source``.\n\n``source`` interpretation is owned by the rule-level ``input_shape``:\n\n- ``input_shape=\"long\"``: ``source`` is an exact vendor column name.\n- ``input_shape=\"wide\"``: ``source`` is a regex over matrix headers and must\n  contain a ``(?P<sample>...)`` named group (enforced on ``ParseRule``).\n\nLayers are optional by default: captured when the ``source`` is present in the\ninput and silently skipped when absent, so a rule can declare the full superset\nof a vendor's volatile columns without rejecting exports that omit some. Set\n``required = true`` to gate a layer (a file missing it is rejected). The\n``axis.x_layer`` is always required regardless of this flag.\n\n``value_pattern`` handles vendor columns whose cells are structured strings rather\nthan bare numbers (PEAKS ``AScore`` is ``site:modification:score``). It is a regex\nwith exactly one capture group, applied per cell before numeric coercion; the first\nmatch wins and non-matching cells become NaN. Without it such a column silently\ncoerces to an all-NaN layer.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "encoding_mode": {
          "default": "numeric",
          "enum": [
            "numeric",
            "factor"
          ],
          "title": "Encoding Mode",
          "type": "string"
        },
        "categories": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Categories",
          "type": "object"
        },
        "missing_values": {
          "items": {
            "type": "number"
          },
          "title": "Missing Values",
          "type": "array"
        },
        "value_pattern": {
          "default": "",
          "title": "Value Pattern",
          "type": "string"
        },
        "required": {
          "default": false,
          "title": "Required",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "source"
      ],
      "title": "Layer",
      "type": "object"
    },
    "LevelRuleFragment": {
      "additionalProperties": false,
      "description": "Strict level body with non-recursive search-parameter axis overrides.\n\n``requires_search_parameters`` gates the level's *availability* rather than its content:\na tool whose quantification settings decide the level of its own output table (Sage's\n``combine_charge_states`` collapses charge states, making one and the same ``lfq.tsv``\nschema ion- or peptidoform-level) cannot be resolved by version or headers, because\nneither differs. A level declaring conditions here is offered only when the parsed\nsearch parameters satisfy every one of them. Levels with no conditions are always\navailable, so this changes nothing for documents that do not use it.",
      "properties": {
        "input_shape": {
          "anyOf": [
            {
              "enum": [
                "long",
                "wide"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Shape"
        },
        "axis": {
          "anyOf": [
            {
              "$ref": "#/$defs/PartialAxis"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "columns": {
          "anyOf": [
            {
              "$ref": "#/$defs/PartialColumns"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "column_roles": {
          "anyOf": [
            {
              "$ref": "#/$defs/ColumnRoles"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "layers": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Layer"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Layers"
        },
        "sample_name_cleanup": {
          "anyOf": [
            {
              "$ref": "#/$defs/SampleNameCleanup"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "modifications": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "site_list": "#/$defs/SiteListModifications",
                  "token_regex": "#/$defs/TokenRegexModifications"
                },
                "propertyName": "parser"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/TokenRegexModifications"
                },
                {
                  "$ref": "#/$defs/SiteListModifications"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Modifications"
        },
        "fragments": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "column": "#/$defs/ColumnLabeledFragments",
                  "positional": "#/$defs/PositionalFragments"
                },
                "propertyName": "label_strategy"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/PositionalFragments"
                },
                {
                  "$ref": "#/$defs/ColumnLabeledFragments"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fragments"
        },
        "search_parameter_overrides": {
          "items": {
            "$ref": "#/$defs/SearchParameterOverride"
          },
          "title": "Search Parameter Overrides",
          "type": "array"
        },
        "requires_search_parameters": {
          "additionalProperties": true,
          "title": "Requires Search Parameters",
          "type": "object"
        }
      },
      "title": "LevelRuleFragment",
      "type": "object"
    },
    "ModificationMapEntry": {
      "additionalProperties": false,
      "description": "User-facing JSON entry: a vendor token plus the Unimod accession.\n\n``name``, ``target``, ``position`` and ``mass_delta`` are NOT carried\non the entry itself \u2014 they are filled at rule-load time from\n``modifications/unimod_registry.toml``. This keeps the per-tool rule files\nfree of duplicated canonical data and guarantees that all tools agree\non what e.g. ``UNIMOD:35`` means.",
      "properties": {
        "token": {
          "title": "Token",
          "type": "string"
        },
        "accession": {
          "title": "Accession",
          "type": "string"
        }
      },
      "required": [
        "token",
        "accession"
      ],
      "title": "ModificationMapEntry",
      "type": "object"
    },
    "PartialAxis": {
      "additionalProperties": false,
      "description": "Axis fragment that becomes complete after merging a document level with its base.",
      "properties": {
        "obs_keys": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Obs Keys"
        },
        "var_keys": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Var Keys"
        },
        "x_layer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "X Layer"
        },
        "duplicates": {
          "anyOf": [
            {
              "$ref": "#/$defs/Duplicates"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "PartialAxis",
      "type": "object"
    },
    "PartialColumnGroup": {
      "additionalProperties": false,
      "description": "Column-group fragment with presence preserved for deterministic merging.",
      "properties": {
        "select": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Select"
        },
        "optional_select": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Optional Select"
        },
        "compute": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/ColumnCompute"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Compute"
        }
      },
      "title": "PartialColumnGroup",
      "type": "object"
    },
    "PartialColumns": {
      "additionalProperties": false,
      "description": "Partial obs/var column declarations used inside a source document.",
      "properties": {
        "obs": {
          "anyOf": [
            {
              "$ref": "#/$defs/PartialColumnGroup"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "var": {
          "anyOf": [
            {
              "$ref": "#/$defs/PartialColumnGroup"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "PartialColumns",
      "type": "object"
    },
    "PositionalFragments": {
      "additionalProperties": false,
      "description": "Older DIA-NN exports with no per-fragment label column.\n\nFragment labels are synthesised positionally (``frag_0``, ``frag_1``, \u2026) by\nindex within the precursor.",
      "properties": {
        "label_strategy": {
          "const": "positional",
          "title": "Label Strategy",
          "type": "string"
        },
        "value_columns": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Value Columns",
          "type": "array"
        },
        "delimiter": {
          "default": ";",
          "title": "Delimiter",
          "type": "string"
        },
        "label_output": {
          "default": "fragment_label",
          "title": "Label Output",
          "type": "string"
        }
      },
      "required": [
        "label_strategy",
        "value_columns"
      ],
      "title": "PositionalFragments",
      "type": "object"
    },
    "RuleFragment": {
      "additionalProperties": false,
      "description": "Strict partial ParseRule body used by a document base.",
      "properties": {
        "input_shape": {
          "anyOf": [
            {
              "enum": [
                "long",
                "wide"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Shape"
        },
        "axis": {
          "anyOf": [
            {
              "$ref": "#/$defs/PartialAxis"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "columns": {
          "anyOf": [
            {
              "$ref": "#/$defs/PartialColumns"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "column_roles": {
          "anyOf": [
            {
              "$ref": "#/$defs/ColumnRoles"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "layers": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Layer"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Layers"
        },
        "sample_name_cleanup": {
          "anyOf": [
            {
              "$ref": "#/$defs/SampleNameCleanup"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "modifications": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "site_list": "#/$defs/SiteListModifications",
                  "token_regex": "#/$defs/TokenRegexModifications"
                },
                "propertyName": "parser"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/TokenRegexModifications"
                },
                {
                  "$ref": "#/$defs/SiteListModifications"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Modifications"
        },
        "fragments": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "column": "#/$defs/ColumnLabeledFragments",
                  "positional": "#/$defs/PositionalFragments"
                },
                "propertyName": "label_strategy"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/PositionalFragments"
                },
                {
                  "$ref": "#/$defs/ColumnLabeledFragments"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fragments"
        }
      },
      "title": "RuleFragment",
      "type": "object"
    },
    "SampleNameCleanup": {
      "additionalProperties": false,
      "properties": {
        "pattern": {
          "default": "",
          "title": "Pattern",
          "type": "string"
        }
      },
      "title": "SampleNameCleanup",
      "type": "object"
    },
    "SearchParameterOverride": {
      "additionalProperties": false,
      "description": "One search-parameter condition and its level-local axis override.",
      "properties": {
        "when_search_parameters": {
          "additionalProperties": true,
          "minProperties": 1,
          "title": "When Search Parameters",
          "type": "object"
        },
        "axis": {
          "$ref": "#/$defs/PartialAxis"
        }
      },
      "required": [
        "when_search_parameters",
        "axis"
      ],
      "title": "SearchParameterOverride",
      "type": "object"
    },
    "SiteListModifications": {
      "additionalProperties": false,
      "description": "Read modifications from parallel name and site columns beside a bare sequence.\n\nThe alphabase layout, used by AlphaDIA::\n\n    sequence     mods                            mod_sites\n    TCSSFIAAMER  Oxidation@M;Carbamidomethyl@C   9;2\n\n``mods`` and ``mod_sites`` are ``delimiter``-joined and paired **index-wise**,\nnot sorted \u2014 above, ``Oxidation@M`` sits at 9 and ``Carbamidomethyl@C`` at 2.\nSites are ``site_base``-indexed into the sequence; site ``0`` denotes the\nN-terminus regardless of ``site_base`` (AlphaDIA writes ``Acetyl@Protein_N-term``\nthat way). Tokens are matched exactly against ``map``, since a name like\n``Oxidation@M`` already carries its own target.",
      "properties": {
        "parser": {
          "const": "site_list",
          "title": "Parser",
          "type": "string"
        },
        "sequence_column": {
          "title": "Sequence Column",
          "type": "string"
        },
        "modification_column": {
          "title": "Modification Column",
          "type": "string"
        },
        "site_column": {
          "title": "Site Column",
          "type": "string"
        },
        "delimiter": {
          "default": ";",
          "title": "Delimiter",
          "type": "string"
        },
        "site_base": {
          "default": 1,
          "maximum": 1,
          "minimum": 0,
          "title": "Site Base",
          "type": "integer"
        },
        "case_sensitive": {
          "default": false,
          "title": "Case Sensitive",
          "type": "boolean"
        },
        "unknown_policy": {
          "default": "preserve",
          "enum": [
            "preserve",
            "drop",
            "error"
          ],
          "title": "Unknown Policy",
          "type": "string"
        },
        "output_column": {
          "default": "proforma_sequence",
          "title": "Output Column",
          "type": "string"
        },
        "map": {
          "items": {
            "$ref": "#/$defs/ModificationMapEntry"
          },
          "minItems": 1,
          "title": "Map",
          "type": "array"
        }
      },
      "required": [
        "parser",
        "sequence_column",
        "modification_column",
        "site_column",
        "map"
      ],
      "title": "SiteListModifications",
      "type": "object"
    },
    "TokenRegexModifications": {
      "additionalProperties": false,
      "description": "Extract vendor modification tokens with a regex and map them to Unimod.\n\nFor vendors that write modifications inline in the sequence itself, e.g.\n``\"PEPM[15.9949]TIDE\"`` or ``\"_(ac)PEPTIDEM(ox)_\"``.",
      "properties": {
        "parser": {
          "const": "token_regex",
          "title": "Parser",
          "type": "string"
        },
        "source_column": {
          "title": "Source Column",
          "type": "string"
        },
        "token_pattern": {
          "title": "Token Pattern",
          "type": "string"
        },
        "token_position": {
          "default": "after_residue",
          "enum": [
            "before_residue",
            "after_residue",
            "n_term",
            "c_term",
            "embedded",
            "unknown"
          ],
          "title": "Token Position",
          "type": "string"
        },
        "case_sensitive": {
          "default": false,
          "title": "Case Sensitive",
          "type": "boolean"
        },
        "unknown_policy": {
          "default": "preserve",
          "enum": [
            "preserve",
            "drop",
            "error"
          ],
          "title": "Unknown Policy",
          "type": "string"
        },
        "output_column": {
          "default": "proforma_sequence",
          "title": "Output Column",
          "type": "string"
        },
        "map": {
          "items": {
            "$ref": "#/$defs/ModificationMapEntry"
          },
          "minItems": 1,
          "title": "Map",
          "type": "array"
        }
      },
      "required": [
        "parser",
        "source_column",
        "token_pattern",
        "map"
      ],
      "title": "TokenRegexModifications",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One self-contained software-version document with shared and level rules.",
  "properties": {
    "schema_version": {
      "title": "Schema Version",
      "type": "string"
    },
    "file_version": {
      "title": "File Version",
      "type": "string"
    },
    "software_name": {
      "title": "Software Name",
      "type": "string"
    },
    "software_version": {
      "title": "Software Version",
      "type": "string"
    },
    "base": {
      "$ref": "#/$defs/RuleFragment"
    },
    "levels": {
      "additionalProperties": {
        "$ref": "#/$defs/LevelRuleFragment"
      },
      "minProperties": 1,
      "propertyNames": {
        "enum": [
          "ion",
          "peptidoform",
          "peptide",
          "protein",
          "fragment"
        ]
      },
      "title": "Levels",
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "file_version",
    "software_name",
    "software_version",
    "base",
    "levels"
  ],
  "title": "ParseRuleDocument",
  "type": "object"
}
