{
  "schema_version": "0.1",
  "file_version": "1",
  "software_name": "PEAKS",
  "software_version": "^13(?:\\.|\\s|$)",
  "base": {
    "input_shape": "wide",
    "axis": {
      "obs_keys": [
        "sample"
      ],
      "duplicates": {
        "mode": "error"
      }
    },
    "columns": {
      "obs": {
        "select": {
          "sample": "<sample>"
        }
      }
    },
    "modifications": {
      "source_column": "Peptide",
      "parser": "token_regex",
      "token_pattern": "\\(([^()]+)\\)",
      "token_position": "after_residue",
      "case_sensitive": false,
      "unknown_policy": "preserve",
      "output_column": "proforma_sequence",
      "map": [
        {
          "token": "+15.99",
          "accession": "UNIMOD:35"
        },
        {
          "token": "+57.02",
          "accession": "UNIMOD:4"
        },
        {
          "token": "+42.01",
          "accession": "UNIMOD:1"
        },
        {
          "token": "+15.9949",
          "accession": "UNIMOD:35"
        },
        {
          "token": "+57.02146",
          "accession": "UNIMOD:4"
        },
        {
          "token": "+42.0106",
          "accession": "UNIMOD:1"
        }
      ]
    }
  },
  "levels": {
    "ion": {
      "axis": {
        "var_keys": [
          "ProForma_ion"
        ],
        "x_layer": "Normalized_Area"
      },
      "columns": {
        "var": {
          "select": {
            "Peptide": "Peptide",
            "Charge": "z",
            "Mz": "m/z",
            "RT_Range": "RT range",
            "Quality": "Quality",
            "Significance": "Significance",
            "Avg_Area": "Avg. Area",
            "Accession": "Accession"
          },
          "compute": [
            {
              "name": "ProForma_peptidoform",
              "from": [
                "Peptide"
              ],
              "how": "proforma_sequence"
            },
            {
              "name": "ProForma_peptide",
              "from": [
                "Peptide"
              ],
              "how": "stripped_sequence"
            },
            {
              "name": "ProForma_ion",
              "from": [
                "ProForma_peptidoform",
                "Charge"
              ],
              "how": "proforma_ion"
            }
          ]
        }
      },
      "column_roles": {
        "protein_accessions": "Accession"
      },
      "layers": [
        {
          "name": "Normalized_Area",
          "source": "^(?P<sample>LFQ_.+?)(?:\\.raw|_raw)? Normalized Area$"
        },
        {
          "name": "Sample_Mz",
          "source": "^(?P<sample>LFQ_.+?)(?:\\.raw|_raw)? m/z$"
        },
        {
          "name": "Sample_RT_Mean",
          "source": "^(?P<sample>LFQ_.+?)(?:\\.raw|_raw)? RT mean$"
        },
        {
          "name": "AScore",
          "source": "^(?P<sample>LFQ_.+?)(?:\\.raw|_raw)? AScore$"
        }
      ]
    }
  }
}
